// ovoa.ai: this site, as a Cloudflare Worker on admin@ovoa.ai's account.
//
//   npm run deploy       build and deploy (ovoa.ai, www.ovoa.ai, ovoa-site.ovoa.workers.dev)
//   npm run db:migrate   create/update the D1 tables (migrations/); run it before deploy
//
// Run both with the admin@ovoa.ai wrangler profile:
//   XDG_CONFIG_HOME=C:/Users/thoma/.wrangler-ovoa npm run deploy
// Secrets are set with `npx wrangler secret put NAME -c wrangler.site.jsonc`
// (setup.md lists them; scripts/stripe-setup.mjs sets the Stripe ones for you).
{
  "name": "ovoa-site",
  "account_id": "e58b0ec5305410f9d3cd70f461f39cb6",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  // Custom domains: Cloudflare makes the DNS records and certificates itself.
  "routes": [
    { "pattern": "ovoa.ai", "custom_domain": true },
    { "pattern": "www.ovoa.ai", "custom_domain": true }
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "SITE_DB",
      "database_name": "ovoa-site-db",
      "database_id": "faf7c32b-f51b-4b67-afd6-2c3cde11d1d0",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "Continue with Google" on /account: the Web client in Google Cloud project
    // ovoa-509511 (admin@ovoa.ai). GOOGLE_CLIENT_SECRET is a secret.
    "GOOGLE_CLIENT_ID": "681579233268-eegju2n5qcpg6ja35np11vpl9fic51pf.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
